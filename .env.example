# 必填：只管理这个完整域名的 RECORD_TYPE 记录
CF_DOMAIN=
# 必填：Token 需该 Zone 的 DNS Read + DNS Edit；自动找 Zone 还需 Zone Read
CF_API_TOKEN=
# 可选：手动填 Zone ID 后不需要 Zone Read
CF_ZONE_ID=

# 仅使用 Docker Hub 发布镜像部署时填写；本地构建不需要
# CFIP_IMAGE=你的DockerHub用户名/cloudflare-ip-tester:3.1.0

# 30 Mbps = 3.75 MB/s；CFST 原始 CSV 的 MiB/s 会由程序换算
MAX_LATENCY_MS=100
MIN_BANDWIDTH_MBPS=30
CHECK_INTERVAL_SECONDS=3600
RECORD_TYPE=A
DNS_TTL=60
INITIAL_SELECT=true

# 默认从 Cloudflare 官方网段均衡随机抽样；仅在重新优选时使用
CANDIDATE_COUNT=128
DOWNLOAD_COUNT=20
CFST_THREADS=8
DOWNLOAD_SECONDS=10
# 文件要足够大，避免 CFST 在下载时间结束前提前下载完而影响采样
CFST_URL=https://speed.cloudflare.com/__down?bytes=200000000
# 可改成自己的稳定直链；出现 429 本周期停止，不自动换源/重试

# 可选：改用你自己的完整 IP 列表（每行一个 IP，最多 512 个，不支持 CIDR）
# 将文件放到 config/candidates.txt，再取消下一行注释
# CANDIDATE_FILE=/config/candidates.txt

# Docker 状态页面；仅绑定部署机器的回环地址
WEB_PORT=8789

# 也支持 Docker secrets：清空 CF_API_TOKEN 并设置 CF_API_TOKEN_FILE=/run/secrets/...
# 兼容 Global API Key：不要同时设置 Token，改填下面两项（推荐用 Token）
# CF_API_KEY=
# CF_EMAIL=
